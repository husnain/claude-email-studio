{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["folder", "findings"],
  "properties": {
    "folder": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "severity", "problem", "fix"],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
